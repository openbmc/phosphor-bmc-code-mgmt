[Unit]
Description=Hot Swap Controller Software Update Daemon
After=xyz.openbmc_project.ObjectMapper.service
After=xyz.openbmc_project.EntityManager.service

[Service]
Restart=always
Type=dbus
BusName=xyz.openbmc_project.Software.I2CHSC
RemainAfterExit=no
ExecStart=/usr/libexec/phosphor-code-mgmt/phosphor-i2chsc-software-update

[Install]
WantedBy=multi-user.target
